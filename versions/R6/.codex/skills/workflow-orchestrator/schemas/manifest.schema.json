{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_type": {
      "const": "manifest"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "extensions": {
      "type": "object"
    },
    "question_id": {
      "type": "string",
      "pattern": "^Q[0-9]+(?:[._-][A-Za-z0-9]+)*$"
    },
    "latest_run": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "current_gate": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "question_id",
    "latest_run"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mathmodel:r6:manifest",
  "title": "manifest"
}
