{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_type": {
      "const": "gate-result"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "extensions": {
      "type": "object"
    },
    "question_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^Q[0-9]+(?:[._-][A-Za-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_gate": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "mechanical_status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "checked_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "generator": {
      "const": "gate_engine.py"
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "question_id",
    "requested_gate",
    "profile",
    "mechanical_status",
    "errors",
    "checked_files",
    "generated_at",
    "generator",
    "limits"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mathmodel:r6:gate-result",
  "title": "gate-result"
}
