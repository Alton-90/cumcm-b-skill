{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_type": {
      "const": "audit"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "extensions": {
      "type": "object"
    },
    "audit_kind": {
      "enum": [
        "consistency",
        "completeness",
        "qa"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^Q[0-9]+(?:[._-][A-Za-z0-9]+)*$"
      },
      "minItems": 1
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "status",
          "reason",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minProperties": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "BLOCKER",
              "WARNING"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "severity",
          "message",
          "owner"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "verdict": {
      "enum": [
        "PASSED",
        "FAILED",
        "NOT_RUN"
      ]
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "audit_kind",
    "scope",
    "checks",
    "findings",
    "inputs"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mathmodel:r6:audit",
  "title": "audit"
}
