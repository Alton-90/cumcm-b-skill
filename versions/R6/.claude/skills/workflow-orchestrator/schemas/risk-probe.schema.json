{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_type": {
      "const": "risk-probe"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "extensions": {
      "type": "object"
    },
    "question_id": {
      "type": "string",
      "pattern": "^Q[0-9]+(?:[._-][A-Za-z0-9]+)*$"
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method_id": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "PASS",
              "CONDITIONAL",
              "FAIL"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "NOT_RUN",
                    "NOT_APPLICABLE"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                }
              },
              "required": [
                "status",
                "reason",
                "evidence"
              ],
              "additionalProperties": false
            },
            "minProperties": 1
          }
        },
        "required": [
          "method_id",
          "verdict",
          "reason",
          "checks"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "question_id",
    "methods"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mathmodel:r6:risk-probe",
  "title": "risk-probe"
}
