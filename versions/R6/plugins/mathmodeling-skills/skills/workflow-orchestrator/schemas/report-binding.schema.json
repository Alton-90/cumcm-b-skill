{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "artifact_type": {
      "const": "report-binding"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "extensions": {
      "type": "object"
    },
    "question_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^Q[0-9]+(?:[._-][A-Za-z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "report_kind": {
      "enum": [
        "method_explanation",
        "final_analysis",
        "robustness_report",
        "writer_package",
        "paper_section",
        "symbols",
        "assumptions",
        "references",
        "literature"
      ]
    },
    "report": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "question_id",
    "report_kind",
    "report",
    "inputs"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mathmodel:r6:report-binding",
  "title": "report-binding"
}
